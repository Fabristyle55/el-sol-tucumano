# Copiá este archivo como ".env" y completalo con los datos de la cuenta de servicio
# (Firebase → ⚙️ Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada).
# NUNCA subas el archivo .env ni el JSON de la clave a GitHub.

FIREBASE_PROJECT_ID=el-sol-tucumano-981aa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@el-sol-tucumano-981aa.iam.gserviceaccount.com
# Copiá el "private_key" del JSON tal cual, entre comillas dobles, con los \n incluidos.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Opcional: URL de un webhook de n8n para mandar avisos por Telegram o mail (Etapa 1).
N8N_WEBHOOK_URL=
