rules_version = '2';

// Reglas de seguridad de Firestore para El Sol Siciliano.
// - Leer: cada rol ve solo lo que necesita.
// - Escribir: casi todo pasa por el backend (Netlify Functions con Firebase Admin),
//   que no está sujeto a estas reglas. Desde el navegador solo el gerente puede
//   editar productos y recetas.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function rol() { return perfil().rol; }
    function personal() { return conSesion() && rol() in ['gerente', 'mostrador', 'panadero', 'deposito', 'repartidor']; }
    function gerente() { return conSesion() && rol() == 'gerente'; }

    match /usuarios/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || gerente());
      allow write: if false;
    }

    match /productos/{id} {
      allow read: if conSesion();
      allow create, update: if gerente();
      allow delete: if false;
    }

    match /clientes/{id} {
      allow read: if personal() || (conSesion() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /pedidos/{id} {
      allow read: if personal() || (conSesion() && resource.data.clienteUid == request.auth.uid);
      allow write: if false;
    }

    // Opiniones de productos: las escriben solo los clientes (una por producto, la propia).
    // El id del documento es "<productoId>_<uid>". El gerente puede borrar cualquiera.
    match /opiniones/{id} {
      allow read: if conSesion();
      allow create, update: if conSesion() && rol() == 'cliente'
        && id == request.resource.data.productoId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 500;
      allow delete: if conSesion() && (resource.data.uid == request.auth.uid || gerente());
    }

    // Despacho: los clientes ven qué hay disponible; las ventas y movimientos solo el personal.
    match /articulos/{id}   { allow read: if conSesion(); allow write: if false; }
    match /ventas/{id}      { allow read: if personal(); allow write: if false; }
    match /movDespacho/{id} { allow read: if personal(); allow write: if false; }

    // Caja y mermas del despacho: solo el personal.
    match /cierres/{id}     { allow read: if personal(); allow write: if false; }
    match /mermas/{id}      { allow read: if personal(); allow write: if false; }

    // Cuenta corriente y pedidos fijos: el personal y el propio cliente.
    match /movCuenta/{id} {
      allow read: if personal() || (conSesion() && resource.data.clienteUid == request.auth.uid);
      allow write: if false;
    }
    match /pedidosFijos/{id} {
      allow read: if personal() || (conSesion() && resource.data.clienteUid == request.auth.uid);
      allow write: if false;
    }

    match /insumos/{id}     { allow read: if personal(); allow write: if false; }
    match /ordenes/{id}     { allow read: if personal(); allow write: if false; }
    match /compras/{id}     { allow read: if personal(); allow write: if false; }
    match /movimientos/{id} { allow read: if personal(); allow write: if false; }
    // Historial: lo escribe el backend. El gerente también deja constancia de lo que
    // edita desde el navegador (recetas y precios), siempre a su nombre.
    match /actividad/{id} {
      allow read: if personal();
      allow create: if gerente() && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 300;
      allow update, delete: if false;
    }
    // Promociones: las de cantidad las ve cualquiera con sesión (el catálogo las muestra);
    // los cupones, con su código, solo el gerente. Se crean desde el backend.
    match /promos/{id} {
      allow read: if gerente() || (conSesion() && resource.data.tipo == 'cantidad');
      allow write: if false;
    }
    match /contadores/{id}  { allow read, write: if false; }
  }
}
