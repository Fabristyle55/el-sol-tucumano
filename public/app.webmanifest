{
  "id": "/app",
  "name": "El Sol App · Panificación El Sol Siciliano",
  "short_name": "El Sol",
  "description": "Lo esencial de la panadería en el celular o la computadora: pedidos, producción, stock, ventas y entregas.",
  "lang": "es-AR",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F4F5F3",
  "theme_color": "#167B41",
  "categories": ["business", "productivity", "food"],
  "icons": [
    { "src": "/marca/sol-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/marca/sol-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/marca/sol-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Pedidos", "url": "/app/pedidos", "icons": [{ "src": "/marca/sol-192.png", "sizes": "192x192" }] },
    { "name": "Vender", "url": "/app/vender", "icons": [{ "src": "/marca/sol-192.png", "sizes": "192x192" }] },
    { "name": "Entregas", "url": "/app/entregas", "icons": [{ "src": "/marca/sol-192.png", "sizes": "192x192" }] }
  ]
}
